//@version=6
indicator("NRL Research Harness v0.1", overlay=false, max_bars_back=5000)

feature = input.string("WT Velocity", "Feature", options=["WT Velocity", "Donchian Position", "Relative Volume", "RSI", "MFI"])
direction = input.string("Long", "Direction", options=["Long", "Short"])
forwardBars = input.int(5, "Forward bars", minval=1, maxval=100)
threshold = input.float(0.0, "Signal threshold", step=0.01)
wtChannel = input.int(10, "WT channel length", minval=2)
wtAverage = input.int(21, "WT average length", minval=2)
donchianLength = input.int(20, "Donchian length", minval=2)
volumeLength = input.int(20, "Relative volume length", minval=2)
rsiLength = input.int(14, "RSI length", minval=2)
mfiLength = input.int(14, "MFI length", minval=2)

ap = hlc3
esa = ta.ema(ap, wtChannel)
de = ta.ema(math.abs(ap - esa), wtChannel)
ci = de == 0.0 ? 0.0 : (ap - esa) / (0.015 * de)
wt1 = ta.ema(ci, wtAverage)
wtVelocity = wt1 - wt1[1]

dcHigh = ta.highest(high, donchianLength)
dcLow = ta.lowest(low, donchianLength)
dcPosition = dcHigh == dcLow ? 0.5 : (close - dcLow) / (dcHigh - dcLow)
relativeVolume = volume / math.max(ta.sma(volume, volumeLength), 1.0)
rsiValue = ta.rsi(close, rsiLength)
mfiValue = ta.mfi(hlc3, mfiLength)

metric = switch feature
    "WT Velocity" => wtVelocity
    "Donchian Position" => dcPosition
    "Relative Volume" => relativeVolume
    "RSI" => rsiValue
    => mfiValue

signal = direction == "Long" ? metric > threshold : metric < threshold
futureReturn = bar_index >= forwardBars ? (close / close[forwardBars] - 1.0) : na
qualifiedReturn = signal[forwardBars] ? futureReturn : na

var int samples = 0
var int wins = 0
var float sumReturns = 0.0
var float sumSquaredReturns = 0.0

if not na(qualifiedReturn)
    samples += 1
    isWin = direction == "Long" ? qualifiedReturn > 0 : qualifiedReturn < 0
    wins += isWin ? 1 : 0
    signedReturn = direction == "Long" ? qualifiedReturn : -qualifiedReturn
    sumReturns += signedReturn
    sumSquaredReturns += signedReturn * signedReturn

meanReturn = samples > 0 ? sumReturns / samples : na
variance = samples > 1 ? math.max(sumSquaredReturns / samples - meanReturn * meanReturn, 0.0) : na
stdReturn = samples > 1 ? math.sqrt(variance) : na
sharpeLike = samples > 1 and stdReturn > 0 ? meanReturn / stdReturn * math.sqrt(samples) : na
winRate = samples > 0 ? wins * 100.0 / samples : na

plot(metric, "Metric")
hline(threshold, "Threshold")

var table results = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(results, 0, 0, "NRL_RESULT")
    table.cell(results, 1, 0, "v0.1")
    table.cell(results, 0, 1, "Feature")
    table.cell(results, 1, 1, feature)
    table.cell(results, 0, 2, "Direction")
    table.cell(results, 1, 2, direction)
    table.cell(results, 0, 3, "Samples")
    table.cell(results, 1, 3, str.tostring(samples))
    table.cell(results, 0, 4, "Win rate")
    table.cell(results, 1, 4, str.tostring(winRate, "#.##"))
    table.cell(results, 0, 5, "Mean return")
    table.cell(results, 1, 5, str.tostring(meanReturn, "#.######"))
    table.cell(results, 0, 6, "Sharpe-like")
    table.cell(results, 1, 6, str.tostring(sharpeLike, "#.###"))
    table.cell(results, 0, 7, "Forward bars")
    table.cell(results, 1, 7, str.tostring(forwardBars))
